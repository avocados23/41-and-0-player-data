# Database connection: DATABASE_URL takes precedence over the individual values.
DATABASE_URL=postgresql://postgres:test@localhost:5432/bracketballer_dev
PSQL_USER=postgres
PSQL_PWD=test
DEV_DB=bracketballer_dev
PSQL_HOST=localhost
PSQL_PORT=5432

# Required by CBBD ingestion jobs.
CBBD_API_KEY=replace-me

# Optional: pin the source revision recorded in data_import_runs.
PIPELINE_COMMIT=
